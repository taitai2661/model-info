{
  "provider": {
    "id": "vercel-ai-gateway",
    "name": "Vercel AI Gateway",
    "types": [
      "api_provider",
      "aggregator",
      "gateway"
    ],
    "website": "https://vercel.com/docs/ai-gateway",
    "documentation_url": "https://vercel.com/docs/ai-gateway/getting-started",
    "status": "active",
    "description": "Vercel's unified AI Gateway: a single OpenAI-compatible endpoint that routes to hundreds of third-party models across OpenAI, Anthropic, Google, Meta, Mistral, xAI, DeepSeek, Moonshot AI and other upstream providers; supports OIDC tokens and provider-specific BYOK keys.",
    "api": {
      "base_url": "https://ai-gateway.vercel.sh/v1",
      "protocol": "https",
      "api_style": "openai_compatible",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "notes": "Either a Vercel OIDC token issued via the AI Gateway (Authorization: Bearer <oidc>), or a per-provider BYOK key (Authorization: Bearer <openai|anthropic|...>). The active provider is selected by the model id prefix."
      },
      "endpoints": {
        "chat_completions": "/chat/completions",
        "responses": "/responses",
        "models": "/models",
        "embeddings": "/embeddings"
      }
    },
    "api_capabilities": {
      "streaming": true,
      "tool_calling": true,
      "structured_output": true,
      "json_mode": true,
      "prompt_caching": true
    },
    "sources": [
      {
        "type": "official",
        "url": "https://vercel.com/docs/ai-gateway/getting-started",
        "retrieved_at": "2026-09-26",
        "title": "Vercel AI Gateway — Getting started"
      },
