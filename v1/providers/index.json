  {
    "id": "aws-bedrock",
    "name": "Amazon Bedrock",
    "types": [
      "api_provider",
      "gateway"
    ],
    "website": "https://aws.amazon.com/bedrock/",
    "documentation_url": "https://docs.aws.amazon.com/bedrock/latest/userguide/what-is-bedrock.html",
    "status": "active",
    "description": "AWS's serverless platform for foundation models from many providers: one endpoint over Anthropic, OpenAI, Meta, Mistral, Moonshot AI, MiniMax, Z.ai and xAI models, behind AWS credentials or a Bedrock API key.",
    "api": {
      "base_url": "https://bedrock-runtime.{region}.amazonaws.com",
      "protocol": "https",
      "api_style": "custom",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "notes": "AWS credentials (Signature Version 4) or an Amazon Bedrock API key, sent as Authorization: Bearer. A second endpoint, https://bedrock-mantle.{region}.api.aws, serves the same OpenAI-compatible paths at /v1 plus Anthropic Messages at /anthropic/v1/messages. The OpenAI-compatible GET /models operation is not implemented; use ListFoundationModels and ListInferenceProfiles instead."
      },
      "endpoints": {
        "chat_completions": "/openai/v1/chat/completions",
        "responses": "/openai/v1/responses"
      }
    },
    "sources": [
      {
        "type": "official",
        "url": "https://aws.amazon.com/bedrock/",
        "retrieved_at": "2026-09-26",
        "title": "Amazon Bedrock"
      },
      {
        "type": "official",
        "url": "https://docs.aws.amazon.com/bedrock/latest/userguide/endpoints",
        "retrieved_at": "2026-09-26",
        "title": "Endpoints supported by Amazon Bedrock",
        "notes": "bedrock-runtime base URL and the /openai/v1 OpenAI-compatible paths."
      },
      {
        "type": "official",
        "url": "https://docs.aws.amazon.com/bedrock/latest/userguide/inference-chat-completions",
        "retrieved_at": "2026-09-26",
        "title": "Chat Completions API",
        "notes": "Per-region chat-completion URLs and the SigV4 / API-key authentication options."
      },
      {
        "type": "official",
        "url": "https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards",
        "retrieved_at": "2026-09-26",
        "title": "Models at a glance",
        "notes": "Catalogue of model cards used to build the relationship entries."
      }
